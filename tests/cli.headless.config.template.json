{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "chromium",
      "headless": true,
      "args": [
        "--disable-extensions-except=__EXTENSION_ROOT__",
        "--load-extension=__EXTENSION_ROOT__"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 900
      }
    }
  }
}
